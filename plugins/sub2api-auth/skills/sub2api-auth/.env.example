# Feishu Base (single source of truth for credentials and state)
FEISHU_BASE_APP_TOKEN=
FEISHU_TABLE_GPT_ACCOUNTS=
FEISHU_TABLE_SIM_CARDS=

# sub2api admin REST API — required, no hardcoded default (never commit real values)
SUB2API_ADMIN_API_KEY=
SUB2API_ADMIN_BASE=http://<sub2api-host>:<port>
# Legacy panel URL (accepted as fallback; any /admin/accounts tail is stripped)
SUB2API_ADMIN_URL=

# OpenCodex public management API behind Cloudflare Access.
# CF_ACCESS_CLIENT_ID and CF_ACCESS_CLIENT_SECRET stay in
# ~/.codex/secrets/opencodex-provider.env; do not duplicate them here.
OCX_ADMIN_BASE=https://<opencodex-host>
OCX_ADMIN_AUTH_TOKEN=
